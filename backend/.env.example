# AutoSats Engine — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database
DB_PATH=autosats.db

# API Keys (placeholders — not used in V0.1 paper mode)
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434

# Stripe (placeholder — not wired in V0.1)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Gumroad (placeholder — not wired in V0.1)
# GUMROAD_ACCESS_TOKEN=...

# BTC (paper mode only — no real keys in V0.1)
# BTC_WALLET_ADDRESS=
# BTC_XPUB=

# Server
HOST=0.0.0.0
PORT=8000
